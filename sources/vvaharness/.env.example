# vvaharness environment — copy to .env and fill in.
# Auto-loaded from exactly the working directory or home; no `source` needed.
# Shell-exported vars win. A `.env` inside the scan target is ignored by default.
# Full per-route matrix and troubleshooting: docs/SETUP_GUIDE.md.
#
# This example file is not installed by `pip`/`pipx`;
# fetch it from the source repository. A `.env` you create from it loads normally.
#
# The first key in each of the three credential sections is left blank as a
# fill-in slot (a blank key is treated as unset). Every other optional variable is COMMENTED OUT rather than left
# blank, and must stay that way: a trailing `#` comment is stripped only from
# a line that has a value, so `KEY=   # note` hands the product `# note` AS
# the value. Uncomment and fill the ones you need.

# ── Minimum for the shipped default profile ──────────────────────────────────
# default.yaml is local S0, then every model role `via: deepagents` + Anthropic.
# ONE credential covers all of it: ANTHROPIC_API_KEY also satisfies `via: sdk`
# roles whenever a profile's backends are only sdk/deepagents. No OpenAI key is
# needed. Missing post-scan credentials skip S10/S11 with a warning;
# `--stop-after s9` is detection-only.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=          # alternative to the key — do not set both
# ANTHROPIC_BASE_URL=            # private Anthropic gateway

# ── Split credentials (only when a `via: cli` role shares the run) ───────────
# A via:cli role withholds the fallback above, because the CLI's token is a
# gateway JWT and the two backends must keep their own credentials.
ANTHROPIC_SDK_API_KEY=
# ANTHROPIC_SDK_BASE_URL=         # same rule as OPENAI_BASE_URL: comment, never blank
# CLAUDE_CODE_OAUTH_TOKEN=       # or an existing `claude` login, for via: cli

# ── OpenAI-compatible endpoints ──────────────────────────────────────────────
# `via: openai`, or `via: deepagents` + `provider: openai`. GLM / Kimi / Qwen /
# Gemini compatible surfaces all use these two. ONE endpoint per run:
# OPENAI_BASE_URL is global, so a mixed fleet needs an aggregating proxy.
OPENAI_API_KEY=
# OPENAI_BASE_URL=                 # REQUIRED for a third-party endpoint; a
#                                  # BLANK value is not 'unset' — it builds a
#                                  # client with an empty base_url and every
#                                  # request fails. Leave commented if unused.
# Route any Gemini-compatible endpoint through
# OPENAI_BASE_URL / OPENAI_API_KEY above, exactly like GLM / Kimi / Qwen.

# ── Private gateway / TLS — absolute paths ───────────────────────────────────
# SSL_CERT_FILE=                 # CA trust for the Python routes
# CLAUDE_CLI_CA_CERT=            # CA bundle for the via:cli `claude` subprocess
# VVAHARNESS_TLS_CLIENT_CERT=    # mTLS, every via:deepagents role (combined PEM)
# VVAHARNESS_TLS_CLIENT_KEY=     # only if the private key is a separate file
# Per-route overrides, when backends need different material:
# ANTHROPIC_SDK_CA_CERT=         # via:sdk + detection via:deepagents (anthropic)
# ANTHROPIC_SDK_CLIENT_CERT=     # ditto — not via:deepagents S10/S11
# OPENAI_CA_CERT=                # via:openai + detection via:deepagents (openai)
# Skipping verification is config-only, never an env var: set `verify_ssl: false`
# in the profile's sdk:/openai:/cli: block. It is MITM-able — prefer a CA bundle.
# Proxy bypass is config-only too: set `no_proxy` in that block. An ambient
# VVAHARNESS_NO_PROXY is ignored (it is an internal carrier, not an env knob).

# ── Optional ─────────────────────────────────────────────────────────────────
# VVAHARNESS_PRICING_FILE=       # none ships; without it every cost_usd is null
# GITHUB_TOKEN=                  # batch cloning
# GIT_BASE_URL=                   # batch cloning; profiles read ${GIT_BASE_URL}

# ── Report ingest upload — Step 9 (optional) ─────────────────────────────────
# After S9, the run can POST its Markdown report and SARIF file to an ingest hub.
# All four profiles read these three variables. The upload needs BOTH a URL and a
# token — leave either unset and it is skipped. VVAHARNESS_INGEST_TOKEN is a bearer
# secret, clear text at rest in your `.env`, so treat it like an EV_AUTH_* credential:
# `chmod 600 .env`, keep it out of version control, and prefer a managed secret store
# over a file. Mind the TLS asymmetry between profiles: `default.yaml` defaults
# ingest_verify to false, so on the default profile the bearer token above travels
# to an unverified endpoint; `full.yaml`, `sdk.yaml` and `taint.yaml` default it to
# true. Set VVAHARNESS_INGEST_VERIFY=true (or a CA-bundle path) whenever the hub is
# not on your own machine.
# VVAHARNESS_INGEST_URL=         # upload destination; unset disables the upload
# VVAHARNESS_INGEST_TOKEN=       # bearer token for the hub — a secret (see above)
# VVAHARNESS_INGEST_VERIFY=      # TLS: true/false or a CA-bundle path (default false)

# ── Exploit verification (optional; BETA — API ONLY) ─────────────────────────
# Confirms findings live against a running target. No CLI flag; a normal SAST scan
# needs none of it. Set BOTH below to enable it. Auth / TLS / OOB variables live in
# `.env.exploit.example`. Full reference: docs/exploit-verification.md.
# EV_API_COLLECTION=             # local path to a Postman v2 / OpenAPI collection;
#                                # setting it is what turns exploit verification on
# EV_TARGET_URL=                 # where those routes are sent. Required once the
#                                # collection is set — without it the run aborts
#                                # before scanning rather than falling back to
#                                # SAST-only. Localhost only (localhost/127.0.0.1/
#                                # ::1), and include scheme AND port: an omitted
#                                # port means 80/443, an omitted scheme is refused
