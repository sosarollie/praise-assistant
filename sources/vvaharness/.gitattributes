# VisaVulnerabilityAgenticHarness .gitattributes

# Normalize line endings on commit; check out platform-native.
* text=auto

# Force EOL by type so scripts stay runnable on every platform.
*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Treat these as binary (no EOL munging, no diff noise).
*.pem  binary
*.p12  binary
*.pfx  binary
*.jks  binary
*.whl  binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.pkl  binary
*.pptx binary
*.docx binary
*.xlsx binary

# Second layer: keep internal artifacts out of `git archive` tarballs even
# if a file slips past .gitignore into the tree.
.env             export-ignore
.env.*           export-ignore
# …but the tracked template MUST ship in release tarballs (documented setup
# step: `cp .env.example .env`). Last matching line wins, so un-set it.
.env.example     -export-ignore
.env.exploit.example     -export-ignore

