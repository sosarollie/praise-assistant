# ─────────────────────────────────────────────────────────────────────────
#  VisaVulnerabilityAgenticHarness .gitignore — hardened for a PUBLIC repo.
#  Goal: secrets, internal data, and runtime artifacts can never be committed.
#  Template files (*.example) are explicitly re-included.
# ─────────────────────────────────────────────────────────────────────────

# ── Secrets & credentials ─────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.exploit.example
# Scoped secret/credential text dumps only — NOT a blanket *.txt (which would
# swallow LICENSEs, fixtures, and any tracked text file tree-wide).
*secret*.txt
*secrets*.txt
*token*.txt
*credentials*.txt
.claude
*.pem
*.key
*.p12
*.pfx
*.jks
*.der
*.crt
*.xlsx
# Local config override (machine-specific keys / endpoints; never published)
config.local.yaml

# Personal per-developer Claude Code instructions — never published
CLAUDE.local.md

# CMDB export (real app data: externally-facing/PCI/PAN/PII flags, internal
# app ids; each user supplies their own). Ignore the real file, keep only the
# *.example.csv template.
inputs/cmdb*.csv
!inputs/cmdb*.example.csv
# Batch repo list (real internal clone URLs / hosts / app ids).
inputs/repos*.csv
!inputs/repos*.example.csv
# Design-controls (describes internal security architecture in `notes`).
inputs/design_controls*.yaml
!inputs/design_controls*.example.yaml
# Live CVE feeds — keep only the *.example.json templates.
inputs/known_cves*.json
!inputs/known_cves*.example.json

# ── Scan outputs & generated reports ──────────────────────────────────────
scans*/
security-scan/
security-remediation/
batch-workspace/
out/
*.sarif
*_report.md
*_report.md.bak

# ── Runtime state & caches ────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
build/
dist/
.venv/
# Also match a bare `.venv` with no slash: worktree agents symlink the main checkout's venv
# so pyright can resolve langchain/deepagents. Without this, `.venv/` (directories only)
# leaves the symlink untracked, the agent deletes it, and re-measures 42 phantom
# reportMissingImports as if they were the baseline.
.venv
.venv.*
venv/
*.log
*.jsonl
*.bak
run_manifest.json
run_manifest_*.json

# ── Editor / OS cruft ─────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
node_modules/
# …except inside the test fixture trees, which deliberately vendor a manifest to
# prove the scanner skips vendored dependencies. Without this exception the
# fixture is silently dropped by `git add` and missing from every fresh clone.
# Git cannot re-include a file whose parent directory is excluded, so the
# directory itself has to be un-ignored (first line) before its contents
# (second line). Real dependency trees anywhere else stay ignored.
!tests/fixtures/**/node_modules/
!tests/fixtures/**/node_modules/**



# user-local config override (copied from a profile) — never commit
config.yaml
# Serena MCP/LSP local tool config -- machine-local, not project config
.serena/

# live-test scratch rig (model profiles, target copies, per-run state/work dirs,
# run logs and scan DBs). Local only — never commit.
livetest/
