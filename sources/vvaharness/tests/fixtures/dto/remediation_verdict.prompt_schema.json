{"$defs":{"Change":{"properties":{"file":{"default":"","description":"repo-relative path that was edited","title":"File","type":"string"},"summary":{"default":"","description":"what changed and why (\u2264 2 sentences)","title":"Summary","type":"string"}},"title":"Change","type":"object"},"Gates":{"properties":{"source":{"default":"fail","description":"Gate A \u2014 attacker-controlled source identified","enum":["pass","partial","fail"],"title":"Source","type":"string"},"sink":{"default":"fail","description":"Gate B \u2014 security-relevant sink reachable from source","enum":["pass","partial","fail"],"title":"Sink","type":"string"},"missing_control":{"default":"fail","description":"Gate C \u2014 missing/insufficient validation","enum":["pass","partial","fail"],"title":"Missing Control","type":"string"}},"title":"Gates","type":"object"}},"description":"Structured result the remediation agent must return for one finding.\n\nOnly ``verdict`` is strictly required; every other field has a safe default\nso a near-complete agent response (e.g. one that omits ``summary``) is\npreserved rather than thrown away. ``verdict`` itself is salvaged in\n:meth:`coerce` when missing/invalid.","properties":{"finding_index":{"default":0,"title":"Finding Index","type":"integer"},"verdict":{"default":"Needs Review","enum":["Fixed","Partially Fixed","Not Fixed","False Positive","Needs Review","Denied"],"title":"Verdict","type":"string"},"gates":{"$ref":"#/$defs/Gates"},"root_cause":{"default":"","description":"one paragraph, cites file:line","title":"Root Cause","type":"string"},"changes":{"description":"edits applied (fix mode) or proposed (report-only)","items":{"$ref":"#/$defs/Change"},"title":"Changes","type":"array"},"remaining_risks":{"items":{"type":"string"},"title":"Remaining Risks","type":"array"},"recommendations":{"description":"code-level follow-ups only \u2014 no operational controls","items":{"type":"string"},"title":"Recommendations","type":"array"},"summary":{"default":"","description":"2-4 sentence human-readable summary","title":"Summary","type":"string"}},"title":"RemediationVerdict","type":"object"}
